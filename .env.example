# Configuration de Ma Badgeuse (copier en .env puis adapter)

# Port publié sur la machine hôte
PORT=3000
# Adresse d'écoute sur l'hôte : 0.0.0.0 = réseau local, 127.0.0.1 = uniquement le proxy HTTPS local
BIND_ADDRESS=0.0.0.0
# Fuseau horaire des dates et des sauvegardes
APP_TIMEZONE=Europe/Paris

# --- Accès en HTTPS via un proxy (recommandé) ---
# true quand l'application est servie en HTTPS : le cookie de session n'est alors jamais envoyé en clair
COOKIE_SECURE=false
# 1 quand un proxy (Caddy, Traefik, Nginx) sur la même machine transmet les requêtes
TRUST_PROXY=
# Origines supplémentaires autorisées (ex : https://badgeuse.maison.lan), séparées par des virgules
ALLOWED_ORIGINS=
