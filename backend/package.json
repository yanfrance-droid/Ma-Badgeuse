{
  "name": "ma-badgeuse-backend",
  "version": "0.3.0",
  "description": "Backend API pour Ma Badgeuse avec SQLite WAL",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test src/tests/comprehensiveAudit.test.ts src/tests/http.test.ts",
    "test:audit": "npm test",
    "reset-password": "tsx src/scripts/resetPassword.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
